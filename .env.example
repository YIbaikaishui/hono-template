# Server
PORT=3000
LOG_LEVEL=info
# CORSMiddleware allowed origins, comma separated
CORS_ORIGINS=http://localhost:5173

# PostgreSQL (docker compose credentials live in .env too)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hono_template
# postgres.js connection pool size (per process)
DB_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379

# Rate limiting (fixed window, per IP)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=60

# Default cache TTL in seconds for read-through caching
CACHE_TTL_SECONDS=60

# docker compose only
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hono_template
